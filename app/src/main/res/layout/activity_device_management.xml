<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ScreenBackground"
    tools:context=".DeviceManagement">

    <!--region 標題區域-->
    <ImageButton
        android:id="@+id/last_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/cardview_mask"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SpeakableTextPresentCheck" />

    <TextView
        android:id="@+id/hello_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="設備管理"
        style="@style/TextColor"
        android:textSize="60sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/last_page"
        android:layout_marginStart="20dp" />

    <!-- 帳號icon -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ic_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <AutoCompleteTextView
            android:id="@+id/autoCompleteTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@color/transparent"
            android:popupTheme="@style/ButtonColor"
            android:drawableStart="@drawable/ic_account_circle_white_100dp"
            android:focusableInTouchMode="false"
            android:gravity="center_horizontal"
            android:inputType="none"
            android:text=""
            android:textSize="30sp"
            android:dropDownWidth="130dp"
            tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 主題設定 -->
    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="主題設定"
        android:textSize="24sp"
        style="@style/TextColor"
        app:layout_constraintBottom_toBottomOf="@+id/ic_account"
        app:layout_constraintTop_toTopOf="@+id/ic_account"
        app:layout_constraintEnd_toStartOf="@+id/ic_account"
        android:layout_marginEnd="16dp"
        />

    <!-- dark mode switch -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:thumb="@drawable/thumb"
        app:layout_constraintEnd_toEndOf="@+id/text1"
        app:layout_constraintStart_toStartOf="@+id/text1"
        app:layout_constraintTop_toBottomOf="@+id/text1"
        app:track="@drawable/track" />
    <!--endregion-->

    <!-- region 狀態欄 -->
    <RelativeLayout
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/last_page"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="20dp"
        android:id="@+id/relativeLayout">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            app:cardBackgroundColor="@color/transparent"
            app:cardElevation="0dp"
            app:cardCornerRadius="10dp"
            android:id="@+id/card_view01">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/ScreenBackground2">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:src="@drawable/ic_wifi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:text="連接成功"
                    style="@style/TextColor"
                    android:textSize="20sp" />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="設備連線狀況"
            style="@style/TextColor"
            android:textSize="20dp"
            android:layout_below="@id/card_view01"
            android:gravity="center"
            android:id="@+id/text_cv"/>
    </RelativeLayout>
    <!--endregion-->

    <!--region 按鈕區域-->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="2"
        app:layout_constraintStart_toEndOf="@+id/relativeLayout"
        app:layout_constraintTop_toBottomOf="@+id/last_page"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/switch_mode">

        <!-- 設備編輯 -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:foreground="@drawable/cardview_mask"
            android:clickable="true"
            android:id="@+id/cv001"
            app:cardElevation="0dp"
            app:cardCornerRadius="10dp">

            <RelativeLayout
                android:layout_width="500dp"
                android:layout_height="200dp"
                style="@style/ScreenBackground2"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="設備編輯"
                    android:textSize="40dp"
                    style="@style/TextColor"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentLeft="true"
                    android:layout_marginTop="40dp"
                    android:layout_marginStart="16dp"
                    android:id="@+id/text_01"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Equipments Editing
"
                    android:textSize="30dp"
                    style="@style/TextColor"
                    android:layout_below="@id/text_01"
                    android:layout_alignParentLeft="true"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="16dp"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_equipment_editing"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="16dp"
                    />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- 維護資料 -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:foreground="@drawable/cardview_mask"
            android:clickable="true"
            android:id="@+id/cv002"
            app:cardElevation="0dp"
            app:cardCornerRadius="10dp">

            <RelativeLayout
                android:layout_width="500dp"
                android:layout_height="200dp"
                style="@style/ScreenBackground2"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="維護資料"
                    android:textSize="40dp"
                    style="@style/TextColor"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentLeft="true"
                    android:layout_marginTop="40dp"
                    android:layout_marginStart="16dp"
                    android:id="@+id/text_02"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maintenance Information"
                    android:textSize="30dp"
                    style="@style/TextColor"
                    android:layout_below="@id/text_02"
                    android:layout_alignParentLeft="true"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="16dp"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_description"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="16dp"
                    />

            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </GridLayout>
    <!--endregion-->

</androidx.constraintlayout.widget.ConstraintLayout>