<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/ScreenBackground"
    tools:context=".DetectSystemUser">

    <!--region 標題區域-->
    <ImageButton
        android:id="@+id/last_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/cardview_mask"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SpeakableTextPresentCheck" />

    <TextView
        android:id="@+id/hello_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="自動偵測系統"
        style="@style/TextColor"
        android:textSize="60sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/last_page"
        android:layout_marginStart="20dp" />

    <!-- 帳號icon -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ic_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <AutoCompleteTextView
            android:id="@+id/autoCompleteTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@color/transparent"
            android:popupTheme="@style/ButtonColor"
            android:drawableStart="@drawable/ic_account_circle_white_100dp"
            android:focusableInTouchMode="false"
            android:gravity="center_horizontal"
            android:inputType="none"
            android:text=""
            android:textSize="30sp"
            android:dropDownWidth="130dp"
            tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 主題設定 -->
    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="主題設定"
        android:textSize="24sp"
        style="@style/TextColor"
        app:layout_constraintBottom_toBottomOf="@+id/ic_account"
        app:layout_constraintTop_toTopOf="@+id/ic_account"
        app:layout_constraintEnd_toStartOf="@+id/ic_account"
        android:layout_marginEnd="16dp"
        />

    <!-- dark mode switch -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:thumb="@drawable/thumb"
        app:layout_constraintEnd_toEndOf="@+id/text1"
        app:layout_constraintStart_toStartOf="@+id/text1"
        app:layout_constraintTop_toBottomOf="@+id/text1"
        app:track="@drawable/track" />
    <!--endregion-->

<RelativeLayout
    android:layout_width="500dp"
    android:layout_height="500dp"
    app:layout_constraintTop_toTopOf="@id/switch_mode"
    android:layout_marginTop="60dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="自偵測系統"
        android:textSize="60dp"
        style="@style/TextColorWithBackground"
        android:gravity="center"
        android:id="@+id/text01"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_below="@id/text01"
        android:backgroundTint="@color/gray9D"
        android:id="@+id/start_time_cardview"
        android:elevation="0dp"
        app:cardUseCompatPadding="true"
        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="187dp">

            <TextView
                style="@style/TextColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:text="開始時間"
                android:textSize="40dp" />

            <TextView
                android:id="@+id/start_time_txt"
                style="@style/TextColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="70dp"
                android:text="時間"
                android:textSize="40dp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_alignParentBottom="true"
        android:backgroundTint="@color/transparent"
        app:cardCornerRadius="20dp"
        android:id="@+id/end_time_cardview">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/BottomRoundedCorner">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="結束時間"
                style="@style/TextColor"
                android:textSize="40dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="時間"
                style="@style/TextColor"
                android:textSize="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="70dp"
                android:layout_marginStart="16dp"
                android:id="@+id/end_time_txt"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>