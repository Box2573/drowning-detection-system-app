<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PeopleManagementAdmin"
    style="@style/ScreenBackground">

    <!--region 標題區域-->
    <ImageButton
        android:id="@+id/last_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/cardview_mask"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SpeakableTextPresentCheck" />

    <TextView
        android:id="@+id/hello_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="人員管理"
        style="@style/TextColor"
        android:textSize="60sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/last_page"
        android:layout_marginStart="20dp" />

    <!-- 帳號icon -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ic_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <AutoCompleteTextView
            android:id="@+id/autoCompleteTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@color/transparent"
            android:popupTheme="@style/ButtonColor"
            android:drawableStart="@drawable/ic_account_circle_white_100dp"
            android:focusableInTouchMode="false"
            android:gravity="center_horizontal"
            android:inputType="none"
            android:text=""
            android:textSize="30sp"
            android:dropDownWidth="130dp"
            tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 主題設定 -->
    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="主題設定"
        android:textSize="24sp"
        style="@style/TextColor"
        app:layout_constraintBottom_toBottomOf="@+id/ic_account"
        app:layout_constraintTop_toTopOf="@+id/ic_account"
        app:layout_constraintEnd_toStartOf="@+id/ic_account"
        android:layout_marginEnd="16dp"
        />

    <!-- dark mode switch -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:thumb="@drawable/thumb"
        app:layout_constraintEnd_toEndOf="@+id/text1"
        app:layout_constraintStart_toStartOf="@+id/text1"
        app:layout_constraintTop_toBottomOf="@+id/text1"
        app:track="@drawable/track" />
    <!--endregion-->

    <Button
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintStart_toStartOf="@id/hello_text"
        app:layout_constraintEnd_toEndOf="@id/hello_text"
        app:layout_constraintTop_toBottomOf="@id/hello_text"
        android:layout_marginTop="16dp"
        android:text="新增"
        style="@style/ButtonColor"
        android:textSize="20dp"
        android:drawableTop="@drawable/ic_add"
        android:background="@drawable/rounded_corner_text_btn_mask"
        android:id="@+id/add_button"
        />

    <RelativeLayout
        android:layout_width="500dp"
        android:layout_height="80dp"
        app:layout_constraintTop_toTopOf="@id/add_button"
        app:layout_constraintTop_toBottomOf="@id/add_button"
        app:layout_constraintStart_toEndOf="@id/add_button"
        android:layout_marginStart="64dp">

        <EditText
            android:layout_width="500dp"
            android:layout_height="80dp"
            android:hint="員工編號"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:textSize="30sp"
            android:background="@drawable/rounded_corner"
            android:padding="18dp"
            android:inputType="text"
            android:layout_marginStart="64dp"
            android:id="@+id/search_input"/>

        <ImageButton
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_alignParentRight="true"
            android:background="@drawable/rounded_btn_mask"
            android:src="@drawable/ic_search"
            tools:ignore="SpeakableTextPresentCheck"
            android:layout_centerVertical="true"
            android:id="@+id/search_button"/>
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/add_button"
        android:layout_marginTop="32dp"
        android:id="@+id/recycler_view"/>

</androidx.constraintlayout.widget.ConstraintLayout>