<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textSize="40dp"
            android:text="設備編號"
            android:layout_alignParentStart="true"
            android:gravity="center"
            android:layout_centerVertical="true"
            android:id="@+id/repair_id"/>

        <TextView
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textSize="40dp"
            android:text="設備名稱"
            android:gravity="center"
            android:padding="10dp"
            android:layout_toRightOf="@id/repair_id"
            android:id="@+id/repair_name"/>

        <TextView
            android:id="@+id/repair_date"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/repair_name"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="維修日期"
            android:textSize="40dp" />

        <TextView
            android:id="@+id/repair_note"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/imageView"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="備註"
            android:textSize="40dp" />

        <ImageButton
            android:id="@+id/imageView"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/rounded_btn_mask"
            android:gravity="center"
            android:src="@drawable/ic_edit"
            tools:ignore="SpeakableTextPresentCheck" />
    </RelativeLayout>


</androidx.cardview.widget.CardView>