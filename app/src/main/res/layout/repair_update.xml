<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="編輯維修資料"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="40dp"
        android:layout_marginTop="16dp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/text"/>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text"
        app:layout_constraintBottom_toTopOf="@id/confirm_button"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/id_input"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_corner"
            android:hint="設備編號"
            android:minHeight="48dp"
            android:paddingLeft="8dp"
            android:textSize="30dp" />

        <EditText
            android:id="@+id/name_input"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:paddingLeft="8dp"
            android:background="@drawable/rounded_corner"
            android:hint="設備名稱"
            android:minHeight="48dp"
            android:textSize="30dp" />

        <EditText
            android:id="@+id/date_input"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:paddingLeft="8dp"
            android:background="@drawable/rounded_corner"
            android:hint="維修日期"
            android:minHeight="48dp"
            android:textSize="30dp" />

        <EditText
            android:id="@+id/note_input"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:layout_marginLeft="16dp"
            android:background="@drawable/rounded_corner"
            android:hint="備註"
            android:textSize="30dp"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/delete_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginLeft="32dp"
        android:background="@drawable/delete_btn"
        android:src="@drawable/ic_delete"
        app:layout_constraintStart_toEndOf="@id/dismiss_button"
        app:layout_constraintTop_toTopOf="@id/dismiss_button"
        app:layout_constraintBottom_toBottomOf="@id/dismiss_button"
        tools:ignore="SpeakableTextPresentCheck" />

    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="確定"
        android:textSize="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        android:layout_marginLeft="200dp"
        android:background="@drawable/confirm_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp"
        android:id="@+id/confirm_button"
        android:layout_marginTop="16dp"/>

    <Button
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="取消"
        android:textSize="40dp"
        app:layout_constraintStart_toEndOf="@id/confirm_button"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        android:layout_marginLeft="50dp"
        android:background="@drawable/dismiss_btn"
        android:id="@+id/dismiss_button"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="16dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>